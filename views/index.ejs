<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Comic+Neue:wght@400;700&display=swap" rel="stylesheet">
    <title>Films: Classics from the Culture</title>
</head>

<body>
    <header class="hero">
        <div class="hero-intro">
            <h1>Films: Classics from the Culture</h1>
            <h2>My watchlist celebrating Black stories, talent and cinema.</h2>
        </div>

        <section class="add-film-panel">
            <h2>Add a Film</h2>

            <form action="/movies" method="POST">
                <label for="title">Movie Title:</label>
                <input type="text" id="title" name="title" placeholder="Name of movie" required>

                <label for="genre">Genre:</label>
                <input type="text" id="genre" name="genre" placeholder="Genre of movie" required>

                <label for="year">Release Year:</label>
                <input type="number" id="year" name="year" min="1900" placeholder="Year released" required>

                <label for="status">Watch Status:</label>
                <select name="status" id="status" required>
                    <option value="">Choose a status</option>
                    <option value="unwatched">Must Watch 🤔🫨</option>
                    <option value="watched">Already Watched 👏🏾🥳</option>
                </select>

                <label for="poster">Poster/Image URL</label>
                <input type="url" id="poster" name="poster" placeholder="Paste image link here!">

                <button type="submit">Add Some Films</button>
            </form>
        </section>
    </header>

    <form action="/" method="GET">

        <label for="search">Search Your Films</label>
        <input type="search" id="search" name="search" placeholder="Enter a movie title">

        <button type="submit">search</button>

        <a href="/">Show All Films</a>
    </form>

    <h2>FILMS</h2>

    <% if (movies.length===0) { %>
        <p>No films to show. Try another search or add a film.</p>
        <% } %>

            <ul class="movies">
                <% for (let i=0; i < movies.length; i++) { %>
                    <li class="movie">
                        <h3>
                            <%= movies[i].title %>
                        </h3>
                        <p>Genre: <%= movies[i].genre %>
                        </p>
                        <p>Release year: <%= movies[i].year %>
                        </p>
                        <p>Status: <%= movies[i].status %>
                        </p>

                        <% if (movies[i].poster) { %>
                            <img src="<%= movies[i].poster %>" alt="Poster for <%= movies[i].title %>" width="150">
                            <% } %>

                                <button type="button" class="status-button" data-id="<%= movies[i]._id %>"
                                    data-status="<%= movies[i].status %>">🔄 Status</button>

                                <button type="button" class="delete-button" data-id="<%= movies[i]._id %>">
                                    🗑️ Film
                                </button>
                    </li>
                    <% } %>
            </ul>

            <script src="/main.js"></script>
</body>

</html>